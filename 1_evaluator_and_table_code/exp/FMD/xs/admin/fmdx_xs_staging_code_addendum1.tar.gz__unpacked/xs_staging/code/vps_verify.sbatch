#!/bin/bash
#SBATCH -J xs_vpsverify
#SBATCH -p cpuidle
#SBATCH -c 1
#SBATCH --mem=2G
#SBATCH -t 01:00:00
#SBATCH -o $U/exp/FMD/xs/logs/vps_verify_%j.out
ssh -i $HOME/.ssh/uhwr_staging_vps_ed25519 -o BatchMode=yes -o ServerAliveInterval=30 Administrator@<ip> "powershell -NoProfile -EncodedCommand " 2>&1 | grep -v CLIXML | grep -E "DONE|BAD|MISSING"
