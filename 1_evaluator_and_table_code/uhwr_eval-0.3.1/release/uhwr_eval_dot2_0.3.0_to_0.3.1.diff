++"""uhwr_eval 0.3.0: body/mark-split order metrics (plan item DOT2, 19 Oct 2026).
++
++New in 0.3.0; nothing in score() or any 0.1.0/0.2.0 metric changes.  Use
++``mark_order_metrics(gt, pred, canvas, gt_is_mark, gt_group=None)`` next to ``score``.
++
++Stroke matching is exactly the matcher of ``metrics.order_metrics`` (``match_strokes``: Hungarian on
++stroke-mask IoU, masks 5 px wide, accept IoU >= 0.5), run on the cleaned inks (``clean_ink``), so the
++matched pairs are the pairs behind ``kendall_tau`` and ``direction_acc`` of ``score(..., 'native')``.
++
++Metrics (all NaN where undefined; every metric has an ``n_`` count of the strokes it averages over):
++  body_direction_acc / mark_direction_acc
++      ``direction_acc`` restricted to matched GT body / GT mark strokes (GT start-end chord >= 2 px:
++      prediction's start nearer the GT start than the GT end).  ``*_ge4`` use a 4 px chord threshold.
++  mark_recall            matched GT marks / GT marks (``n_gt_marks``)
++  body_recall            matched GT bodies / GT bodies
++  mark_kendall_tau       Kendall tau-b between GT and predicted indices over matched marks (>= 2)
++  body_kendall_tau       the same over matched bodies
++  mark_before_body_recall
++      over GT marks written before the first body stroke of their own group (``gt_group``; the whole
++      ink is one group when None) whose own first body is also matched: share whose predicted index is
++      also before the predicted index of that body.  ``n_gt_mark_before_body`` = number of such GT marks
++      (all, matched or not); ``gt_mark_before_body_flag`` = 1 if the ink has at least one.
++  mark_after_body_kept
++      the same for GT marks written after their group's first body: share whose predicted index is also
++      after it (so a method that moves marks early is visible).
++  mark_slot_body_exact
++      over matched GT marks whose last GT body stroke written before them is matched (or there is none): share
++      whose last predicted stroke matched to a GT body, before the mark's prediction, is that body's match
++      (-1 = none).  This is the PF2 slot (predecessor body); unmatched predicted strokes are ignored.
++  mark_slot_exact
++      over matched GT marks whose GT predecessor stroke (the stroke written just before the mark, any
++      kind; -1 = first stroke) is matched or is -1: share whose matched prediction has the matched
++      counterpart of that predecessor as its predicted predecessor (pred index - 1).
++"""
++from __future__ import annotations
++
++from typing import Dict, Optional, Sequence
++
++import numpy as np
++from scipy.stats import kendalltau
++
++from .metrics import match_strokes
++from .strokes import clean_ink
++
++MARK_METRICS = {
++    "body_direction_acc": ("\u2191", "proposed", "direction_acc over matched GT body strokes (chord >= 2 px)"),
++    "mark_direction_acc": ("\u2191", "proposed", "direction_acc over matched GT mark strokes (chord >= 2 px)"),
++    "body_direction_acc_ge4": ("\u2191", "proposed", "as body_direction_acc, chord >= 4 px"),
++    "mark_direction_acc_ge4": ("\u2191", "proposed", "as mark_direction_acc, chord >= 4 px"),
++    "mark_recall": ("\u2191", "proposed", "matched GT marks / GT marks (same matcher as kendall_tau)"),
++    "body_recall": ("\u2191", "proposed", "matched GT bodies / GT bodies"),
++    "mark_kendall_tau": ("\u2191", "proposed", "Kendall tau-b over matched GT marks (>= 2)"),
++    "body_kendall_tau": ("\u2191", "proposed", "Kendall tau-b over matched GT bodies (>= 2)"),
++    "mark_before_body_recall": ("\u2191", "proposed", "GT marks written before own group's first body: share also predicted before it"),
++    "mark_after_body_kept": ("\u2191", "proposed", "GT marks written after own group's first body: share also predicted after it"),
